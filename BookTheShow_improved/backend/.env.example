# ============================================================
# BookTheShow — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ── Database ──────────────────────────────────────────────
DB_PATH=./db/bookyourshow.sqlite

# ── Seat holds & waitlist ─────────────────────────────────
# How long a waitlisted customer has to claim an offered seat (seconds):
WAITLIST_OFFER_TTL_SECONDS=300
# Scheduler tick — how often expired holds / offers are swept (ms):
SCHEDULER_TICK_MS=5000

# ── Email — choose ONE of the options below ────────────────

# OPTION A (Recommended): Gmail with an App Password
#   Steps:
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" + "Other — type BookTheShow")
#   4. Copy the 16-character code (no spaces) into GMAIL_APP_PASSWORD below.
#   5. Set GMAIL_USER to your full Gmail address.
GMAIL_USER=dummytsttt@gmail.com
GMAIL_APP_PASSWORD=bsxy olxs xedx vebz

# OPTION B: Generic SMTP (SendGrid, Brevo, Mailgun, Zoho, etc.)
#   Leave blank if using OPTION A.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Fallback "From" address when not using Gmail (overridden by GMAIL_USER if set):
MAIL_FROM="BookTheShow <dummytsttt@gmail.com>"

# ── Leave everything above blank to use the Ethereal fallback ─
#   (Free test inbox — email is NOT delivered to real inboxes.
#    A preview URL will appear in the server console instead.)
